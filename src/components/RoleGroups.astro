---
/* The keys of colors.toml as empty slots: the system names a place for a
   color and says what it paints, and the theme decides what goes in it. */
import { ROLE_GROUPS, TERMINAL } from "../data/roles";
---

{
  ROLE_GROUPS.map((g) => (
    <section class="rgroup">
      <h3>{g.title}</h3>
      <p class="about">{g.about}</p>
      <table>
        <thead>
          <tr>
            <th>Key</th>
            <th>Paints</th>
            <th>If a theme leaves it out</th>
          </tr>
        </thead>
        <tbody>
          {g.roles.map((r) => (
            <tr>
              <td class="rname">
                <span class="slot" aria-hidden="true" />
                <code>{r.key}</code>
              </td>
              <td>{r.paints}</td>
              <td class:list={["fb", { req: !r.fallback }]}>{r.fallback ?? "required"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))
}

<section class="rgroup">
  <h3>Terminal</h3>
  <p class="about">
    Terminals still count colors 0 to 15. Omarchy fills each from a key above, so a theme never sets
    them directly.
  </p>
  <ol class="term">
    {
      TERMINAL.map((t) => (
        <li>
          <span class="n">color{t.n}</span>
          <code>{t.key}</code>
          <span class="tname">{t.name}</span>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .rgroup + .rgroup {
    margin-top: 8px;
  }
  .about {
    color: var(--ink2);
  }
  .rname {
    white-space: nowrap;
  }
  /* an empty slot: dashed, because the theme fills it, not the system */
  .slot {
    display: inline-block;
    width: 14px;
    height: 14px;
    margin-right: 10px;
    vertical-align: -2px;
    border: 1px dashed var(--neutral-500);
  }
  .fb {
    color: var(--dim);
  }
  .fb.req {
    color: #fff;
  }
  .term {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    max-width: none !important;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    border-top: 1px solid var(--guide);
    font-size: 13px;
  }
  .term li {
    margin: 0 !important;
    padding: 9px 0;
    border-bottom: 1px solid var(--guide);
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .n {
    width: 7ch;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
  .tname {
    color: var(--dim2);
    font-size: 11px;
  }
</style>
