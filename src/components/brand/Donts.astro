---
/* Misuse, drawn from the real wordmark so the examples never drift from
   the mark itself. */
import Mark from "../Mark.astro";
import { MARKS, REFERENCE_BANDS } from "../../lib/brand";

const w = MARKS.wordmark;
const reversed = REFERENCE_BANDS.toReversed();
const offRule = ["#ff5f7e", "#ffb347", "#f9f871", "#4ade80", "#60a5fa"];
const i = MARKS.icon;
const u = w.unit;
/* the lockup put back together wrongly: icon after the word, loose gap */
const swapped = {
  ...w,
  id: "bad-lockup",
  w: w.w + 9 * u + 240,
  content:
    w.content +
    `<g transform="translate(${w.w + 9 * u},30) scale(${(240 / i.w).toFixed(6)})">${i.content}</g>`,
};
---

<ul class="donts">
  <li>
    <div class="tile"><Mark mark={w} style="transform: scale(1.3, 0.72)" /></div>
    <span>Don't stretch or squash it.</span>
  </li>
  <li>
    <div class="tile"><Mark mark={w} style="transform: rotate(-9deg)" /></div>
    <span>Don't rotate it.</span>
  </li>
  <li>
    <div class="tile outline"><Mark mark={w} fill="none" /></div>
    <span>Don't outline it.</span>
  </li>
  <li>
    <div class="tile glow"><Mark mark={w} bands={REFERENCE_BANDS} /></div>
    <span>Don't add shadows, glows or bevels.</span>
  </li>
  <li>
    <div class="tile"><Mark mark={w} bands={reversed} /></div>
    <span>Don't flip the bands. Light is always on top.</span>
  </li>
  <li>
    <div class="tile"><Mark mark={w} bands={offRule} /></div>
    <span>Don't band it in unrelated colors. The five come from one accent.</span>
  </li>
  <li>
    <div class="tile low"><Mark mark={w} fill="#3a3a3a" /></div>
    <span>Don't set it where it can't be read.</span>
  </li>
  <li>
    <div class="tile"><Mark mark={swapped} /></div>
    <span>Don't rebuild the lockup. Use the one that ships.</span>
  </li>
</ul>

<style>
  .donts {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px 12px;
    max-width: none !important;
  }
  .donts li {
    margin: 0 !important;
    font-size: 12px;
    line-height: 1.55;
    color: var(--ink2);
  }
  .tile {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    padding: 0 16%;
    margin-bottom: 8px;
    background: var(--neutral-950);
    border: 1px solid var(--guide);
    color: var(--neutral-200);
    overflow: hidden;
  }
  /* a strike through every tile: these are what not to do */
  .tile::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top right,
      transparent calc(50% - 0.5px),
      var(--neutral-500) calc(50% - 0.5px),
      var(--neutral-500) calc(50% + 0.5px),
      transparent calc(50% + 0.5px)
    );
  }
  .outline :global(g) {
    stroke: var(--neutral-200);
    stroke-width: 4;
  }
  .glow :global(svg) {
    filter: drop-shadow(6px 8px 0 #000) drop-shadow(0 0 14px #82fb9c);
  }
  .low {
    background: #2e2e2e;
  }
</style>
