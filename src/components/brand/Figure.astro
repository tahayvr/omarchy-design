---
/* A framed exhibit with a caption: the ground every brand diagram sits on. */
interface Props {
  caption?: string;
  tone?: "dark" | "panel";
  class?: string;
}
const { caption, tone = "dark", class: cls } = Astro.props;
---

<figure class:list={["fig", tone, cls]}>
  <div class="stage"><slot /></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig {
    margin: 0 0 28px;
    border: 1px solid var(--guide);
  }
  .stage {
    padding: clamp(20px, 4vw, 40px);
    color: var(--neutral-200);
  }
  .dark .stage {
    background: var(--neutral-950);
  }
  .panel .stage {
    background: var(--neutral-900);
  }
  figcaption {
    border-top: 1px solid var(--guide);
    padding: 10px 14px;
    font-size: 12px;
    color: var(--dim);
  }
</style>
