---
/* A mark inside its clear space, with the clear unit drawn in each corner. */
import { clearSpace, type Mark } from "../../lib/brand";

interface Props {
  mark: Mark;
}
const { mark: m } = Astro.props;
const c = clearSpace(m);
const px = c / m.unit;
const lab = c * 0.55;
---

<svg class="cs" viewBox={`${-c * 1.25} ${-c * 1.25} ${m.w + c * 2.5} ${m.h + c * 2.5}`} role="img" aria-label={`${m.label} clear space: ${px} pixels on every side`}>
  <rect x={-c} y={-c} width={m.w + 2 * c} height={m.h + 2 * c} fill="none" stroke="var(--neutral-500)" stroke-dasharray="6 6" vector-effect="non-scaling-stroke" />
  <g fill="var(--neutral-500)" fill-opacity="0.3">
    <rect x={-c} y={-c} width={c} height={c} />
    <rect x={m.w} y={-c} width={c} height={c} />
    <rect x={-c} y={m.h} width={c} height={c} />
    <rect x={m.w} y={m.h} width={c} height={c} />
  </g>
  <g fill="var(--neutral-300)" set:html={m.content} />
  <text x={-c / 2} y={-c / 2 + lab / 3} text-anchor="middle" fill="var(--neutral-300)" font-family="var(--mono)" font-size={lab}>{px}</text>
</svg>

<style>
  .cs {
    display: block;
    width: 100%;
    height: auto;
    max-height: 320px;
  }
</style>
