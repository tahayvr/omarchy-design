---
/* One page per part of the desktop: a live preview in any theme, how to use
   it, and the tokens it's painted with, straight from Omarchy's template. */
import Docs from "../../layouts/Docs.astro";
import ThemePicker from "../../components/desktop/ThemePicker.astro";
import Shot from "../../components/desktop/Shot.astro";
import TokenTable from "../../components/desktop/TokenTable.astro";
import { COMPONENTS, type Component } from "../../data/components";
import { sectionSource } from "../../lib/shell";

export function getStaticPaths() {
  return COMPONENTS.map((c) => ({ params: { component: c.id }, props: { c } }));
}

const { c } = Astro.props as { c: Component };

/* usage lines carry `code` and [links](url); nothing else */
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;");
const md = (s: string) =>
  esc(s)
    .replace(/`([^`]+)`/g, "<code>$1</code>")
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');

const headings = [
  { depth: 2, slug: "preview", text: "Preview" },
  { depth: 2, slug: "usage", text: "Usage" },
  { depth: 2, slug: "tokens", text: "Tokens" },
  { depth: 2, slug: "in-shell-toml", text: "In shell.toml" },
];
---

<Docs
  title={c.title}
  description={c.blurb}
  status="draft"
  headings={headings}
  file="src/data/components.ts"
>
  <h2 id="preview">Preview</h2>
  <ThemePicker />
  <Shot kind={c.id} />
  <p class="note">
    Schematic: the layout is approximate, but every color, alpha and border is the template's own
    token in the theme you pick.
  </p>

  <h2 id="usage">Usage</h2>
  <ul>
    {c.usage.map((u) => <li set:html={md(u)} />)}
  </ul>

  <h2 id="tokens">Tokens</h2>
  <p>
    Each token is a <a href="../../foundations/color/">colors.toml key</a>, sometimes mixed or made
    translucent. Swatches show the theme being previewed.
  </p>
  {c.sections.map((id) => <TokenTable id={id} />)}

  <h2 id="in-shell-toml">In shell.toml</h2>
  <p>
    As Omarchy's template writes it. A theme can replace the whole file by shipping its own
    <code>shell.toml</code>.
  </p>
  {
    c.sections.map((id) => <pre set:html={`<code>${esc(sectionSource(id))}</code>`} />)
  }
</Docs>

<style>
  .note {
    margin-top: 10px;
    font-size: 12px;
    color: var(--dim);
  }
</style>
