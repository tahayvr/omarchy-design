---
/* The type sheet, moved from /type/ into the docs. Each specimen sets
   itself in the face it describes. */
import Docs from "../../layouts/Docs.astro";

const headings = [
  { depth: 2, slug: "faces", text: "The two faces" },
  { depth: 2, slug: "in-use", text: "In use" },
  { depth: 2, slug: "rules", text: "Rules" },
];
---

<Docs
  title="Typography"
  description="Two typefaces. Geist carries the headings, JetBrains Mono carries everything else."
  headings={headings}
  file="src/pages/foundations/typography.astro"
>
  <h2 id="faces">The two faces</h2>
  <div class="specimens">
    <article class="specimen sans">
      <div class="meta"><span>01 — heading</span><span>sans</span></div>
      <p class="name">Geist</p>
      <p class="glyph" aria-hidden="true">Aa</p>
      <div class="alphabet" aria-label="character set">
        <span>ABCDEFGHIJKLMNOPQRSTUVWXYZ</span>
        <span>abcdefghijklmnopqrstuvwxyz</span>
        <span>0123456789</span>
      </div>
      <ul class="weights">
        <li class="w300">Light — The quick brown fox</li>
        <li class="w400">Regular — The quick brown fox</li>
        <li class="w500">Medium — The quick brown fox</li>
        <li class="w700">Bold — The quick brown fox</li>
      </ul>
      <p class="use">Use for headings, titles and display sizes.</p>
      <p class="links">
        <span>download</span>
        <a href="https://github.com/vercel/geist-font/releases" target="_blank" rel="noopener">github</a>
        <a href="https://fonts.google.com/specimen/Geist" target="_blank" rel="noopener">google fonts</a>
        <span class="lic">SIL OFL 1.1</span>
      </p>
    </article>

    <article class="specimen mono">
      <div class="meta"><span>02 — body</span><span>mono</span></div>
      <p class="name">JetBrains Mono</p>
      <p class="glyph" aria-hidden="true">Aa</p>
      <div class="alphabet" aria-label="character set">
        <span>ABCDEFGHIJKLMNOPQRSTUVWXYZ</span>
        <span>abcdefghijklmnopqrstuvwxyz</span>
        <span>0123456789</span>
      </div>
      <ul class="weights">
        <li class="w400">Regular — The quick brown fox</li>
        <li class="w500">Medium — The quick brown fox</li>
        <li class="w700">Bold — The quick brown fox</li>
      </ul>
      <p class="use">Use for body copy, interface text and code.</p>
      <p class="links">
        <span>download</span>
        <a href="https://www.jetbrains.com/lp/mono/" target="_blank" rel="noopener">jetbrains</a>
        <a href="https://github.com/JetBrains/JetBrainsMono/releases" target="_blank" rel="noopener">github</a>
        <a href="https://fonts.google.com/specimen/JetBrains+Mono" target="_blank" rel="noopener">google fonts</a>
        <span class="lic">SIL OFL 1.1</span>
      </p>
    </article>
  </div>

  <h2 id="in-use">In use</h2>
  <div class="pair">
    <p class="headline">We can fix everything!</p>
    <p class="body">
      Linux used to be a chore to setup, difficult to debug, and full of confusing upfront choices.
      Omarchy solves all of it with a lightning fast installation, agents that debug all issues, and
      fantastic defaults that give you a fully functioning system that looks amazing out of the box.
    </p>
  </div>

  <h2 id="rules">Rules</h2>
  <ul>
    <li>Geist for headings only. Never set body copy or interface labels in it.</li>
    <li>JetBrains Mono for everything a person reads at length or types.</li>
    <li>Small labels go uppercase with 0.06em tracking; running text never does.</li>
    <li>
      Type takes its color from the theme's keys: <code>foreground</code> for text,
      <code>light_foreground</code> for what's secondary. <code>dark_foreground</code> and
      <code>muted</code> only for what a person can miss.
    </li>
  </ul>
</Docs>

<style>
  .specimens {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    margin-bottom: 16px;
  }
  .specimen {
    min-width: 0;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    color: var(--dim);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  :global(.prose) .name {
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 500;
    line-height: 1.1;
    margin: 14px 0 0;
    letter-spacing: -0.01em;
    color: #fff;
  }
  :global(.prose) .glyph {
    font-size: clamp(96px, 12vw, 176px);
    line-height: 1;
    margin: 14px 0 0;
    letter-spacing: -0.03em;
    color: var(--neutral-200);
  }
  .alphabet {
    display: grid;
    gap: 4px;
    font-size: clamp(14px, 1.3vw, 17px);
    line-height: 1.4;
    margin: 24px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--guide);
  }
  .alphabet span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 0.02em;
  }
  :global(.prose) .weights {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 15px;
  }
  :global(.prose) .use {
    color: var(--dim);
    font-size: 12px;
    margin: 24px 0 0;
  }
  :global(.prose) .links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: baseline;
    font-size: 12px;
    margin: 12px 0 0;
    color: var(--dim2);
  }
  :global(.prose) .links a {
    color: var(--ink2);
    border-bottom-color: var(--neutral-700);
  }
  .lic {
    margin-left: auto;
  }
  .sans .name,
  .sans .glyph,
  .sans .alphabet,
  .sans .weights {
    font-family: var(--sans);
  }
  .w300 {
    font-weight: 300;
  }
  .w400 {
    font-weight: 400;
  }
  .w500 {
    font-weight: 500;
  }
  .w700 {
    font-weight: 700;
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }
  :global(.prose) .headline {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(32px, 3.8vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
    color: #fff;
  }
  :global(.prose) .body {
    font-size: 15px;
    line-height: 1.75;
    margin: 0;
  }

  @media (max-width: 1100px) {
    .specimens,
    .pair {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
