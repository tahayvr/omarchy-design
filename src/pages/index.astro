---
/* The homepage: the logo on its guide lines, three doors under it, and the
   foundations along the foot. */
import Base from "../layouts/Base.astro";
import { url } from "../data/nav";
import "../styles/home.css";

const doors = [
  { title: "Brand", href: "/brand/", blurb: "How Omarchy looks and speaks." },
  { title: "Desktop UI", href: "/desktop/", blurb: "How the desktop is built, in any theme." },
  { title: "Tools", href: "/tools/", blurb: "Generators that follow the rules for you." },
];
---

<Base description="The design system for Omarchy: its brand, the rules its desktop is built on, and the tools that apply them.">
  <main class="home">
    <div class="hero">
      <div class="logobox">
        <div class="guides" aria-hidden="true">
          <i class="v"></i><i class="v"></i><i class="v"></i><i class="v"></i><i class="v"></i><i
            class="v"></i><i class="v"></i><i class="v"></i><i class="h"></i><i class="h"></i><i
            class="h"></i><i class="h"></i>
        </div>
        <img
          class="logo"
          src={url("/assets/omarchy-design-logo.svg")}
          alt="Omarchy Design"
          width="885"
          height="203"
        />
      </div>
      <nav class="nav" aria-label="sections">
        {
          doors.map((d) => (
            <a href={url(d.href)}>
              <span class="door">{d.title}</span>
              <span class="blurb">{d.blurb}</span>
            </a>
          ))
        }
      </nav>
    </div>
    <nav class="found" aria-label="foundations">
      <a class="label" href={url("/foundations/")}>Foundations</a>
      <a href={url("/foundations/color/")}>color roles</a>
      <a href={url("/foundations/typography/")}>typography</a>
      <a class="about" href={url("/about/")}>about</a>
    </nav>
  </main>
</Base>
